"use client";

import { PrivyProvider } from "@privy-io/react-auth";

export function PrivyProvider({ children }: { children: React.ReactNode }) {
  return (
    <PrivyProvider
      appId={process.env.NEXT_PUBLIC_PRIVY_APP_ID!}
      config={
        appearance: {
          theme: "light",
          accentColor: "#3b82f6",
        },
        embeddedWallets: {
          createOnLogin: "users-without-wallets",
        },
      }
    >
      {children}
    </PrivyProvider>
  );
}