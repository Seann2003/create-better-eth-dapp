import { createConfig, http } from 'wagmi';
import { mainnet, sepolia } from 'wagmi/chains';
import { injected, walletConnect, coinbaseWallet } from 'wagmi/connectors';

// WalletConnect configuration
const projectId = process.env.NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID!;

if (!projectId) {
  throw new Error('NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID is required');
}

// Configure connectors
const connectors = [
  // Injected connector for browser wallets (MetaMask, etc.)
  injected(),
  
  // WalletConnect connector for mobile wallets
  walletConnect({
    projectId,
    metadata: {
      name: '{{projectName}}',
      description: '{{projectName}} - Ethereum dApp',
      url: 'https://{{projectName}}.com',
      icons: ['https://{{projectName}}.com/icon.png'],
    },
  }),
  
  // Coinbase Wallet connector
  coinbaseWallet({
    appName: '{{projectName}}',
    appLogoUrl: 'https://{{projectName}}.com/icon.png',
  }),
];

// Create wagmi configuration
export const config = createConfig({
  chains: [mainnet, sepolia],
  connectors,
  transports: {
    [mainnet.id]: http(),
    [sepolia.id]: http(),
  },
  ssr: true, // Enable SSR support
});

// Export types for better TypeScript support
export type Config = typeof config;