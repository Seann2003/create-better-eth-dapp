'use client';
import React from 'react';
import { usePrivy, useWallets } from '{{#if (eq auth "privy")}}@privy-io/react-auth{{else}}@thirdweb-dev/react{{/if}}';

export default function Page() {
  {{#if (eq auth "privy")}}
  const { ready, authenticated, login, logout } = usePrivy();
  {{else}}
  const { connect, disconnect, address } = useWallets();
  {{/if}}

  return (
    <main className="p-6">
      <h1 className="text-xl font-bold">Hello {{auth}}!</h1>
      {{#if (eq auth "privy")}}
      {ready && !authenticated && <button onClick={login}>Login</button>}
      {authenticated && <button onClick={logout}>Logout</button>}
      {{else}}
      {!address ? (
        <button onClick={connect}>Connect Wallet</button>
      ) : (
        <button onClick={disconnect}>Disconnect</button>
      )}
      {{/if}}
    </main>
  );
}